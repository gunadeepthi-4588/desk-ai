# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_GENERATIVE_MODEL=gemini-3.1-flash-lite

# Supabase Configuration
# URL of your Supabase project (e.g., https://xyz.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co
# Anon / Publishable key
SUPABASE_KEY=your-anon-or-publishable-key-here
# Backend-only Service Role key (Used securely by Flask backend to bypass RLS for document ingestion)
# NEVER expose this key to frontend JavaScript
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Flask Configuration
FLASK_ENV=development
PORT=5000

